#!/bin/sh
# setup — prepare a clean machine: macOS or Linux. Windows — bin\setup.ps1.
#
# Executor of meta-vault/operations/add-engine.md and of the «first launch» step.
# Run from anywhere:  sh bin/setup
# What it does: checks git and Python 3.10+, installs Python via Homebrew
# if it is missing; if there is an engine (engine/pyproject.toml or
# engine/requirements.txt) — creates .venv at the root and installs the
# dependencies; the engine's system packages — engine/setup-extra.sh, if it
# exists; creates secrets/ (outside git); at the end — a bin/check run.
# Re-running is safe: it installs only what is missing.
set -e
cd "$(dirname "$0")/.."
echo "setup: $(pwd)"

if ! command -v git >/dev/null 2>&1; then
  echo "no git. macOS: xcode-select --install · Linux: the package manager"
  exit 1
fi

find_py() {
  # Versioned names first: on macOS python3 is often the system 3.9,
  # while the needed 3.12 sits beside it as python3.12.
  for c in python3.14 python3.13 python3.12 python3.11 python3.10 python3 python; do
    if command -v "$c" >/dev/null 2>&1 &&
       "$c" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 10) else 1)' 2>/dev/null; then
      echo "$c"; return
    fi
  done
}
PY="$(find_py)"
if [ -z "$PY" ]; then
  # Install only when there is no suitable Python at all: brew install over
  # an existing one would upgrade it, and that is not our business.
  if [ "$(uname)" = Darwin ] && command -v brew >/dev/null 2>&1; then
    brew install python@3.12
    PY="$(brew --prefix)/bin/python3.12"
  else
    echo "Python 3.10+ is needed."
    echo "  macOS: install Homebrew (https://brew.sh), then brew install python@3.12"
    echo "  Linux: python3 from the package manager"
    exit 1
  fi
fi
echo "python: $($PY --version)"

if [ -f engine/pyproject.toml ] || [ -f engine/requirements.txt ]; then
  [ -d .venv ] || "$PY" -m venv .venv
  .venv/bin/python -m pip install -q --upgrade pip
  if [ -f engine/pyproject.toml ]; then
    .venv/bin/python -m pip install -q -e engine
  else
    .venv/bin/python -m pip install -q -r engine/requirements.txt
  fi
  if [ -f engine/setup-extra.sh ]; then sh engine/setup-extra.sh; fi
  echo "engine: .venv ready"
else
  echo "no engine — nothing to install"
fi

mkdir -p secrets
"$PY" bin/check --quiet || echo "bin/check found things to fix — run it without --quiet"
echo "done"

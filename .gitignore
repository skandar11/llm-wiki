# --- секреты: никогда не коммитить ---
secrets/*
!secrets/README.md
.env
*.env
!.env.example
*.key
*.pem
id_*

# --- файлы доменов: структура трекается, содержимое локально ---
project/docs/*
!project/docs/README.md
project/inbox/*
!project/inbox/README.md
office/docs/*
!office/docs/README.md
office/inbox/*
!office/inbox/README.md

# --- ОС / редакторы ---
.DS_Store
.obsidian/

# --- python (когда появятся код-проекты) ---
__pycache__/
*.pyc
.venv/
venv/
